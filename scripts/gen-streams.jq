# Streaming operations -> crates/x-sdk/src/stream_endpoints.rs
[.paths[][] | select(type == "object" and .["x-twitter-streaming"] == true)]
| map({
    id: .operationId,
    item: (.responses["200"].content["application/json"].schema["$ref"] | split("/") | last)
  })
| sort_by(.id)
| map(
    . + {
      pascal: (.id[:1] | ascii_upcase) + .id[1:],
      snake: (.id | gsub("(?<c>[A-Z])"; "_" + (.c | ascii_downcase)))
    }
  )
| "// @generated by `just gen-streams` from the spec. Do not edit.\n"
+ "\n"
+ "use x_sdk_gen::apis::{configuration::Configuration, stream_api};\n"
+ "use x_sdk_gen::models;\n"
+ "\n"
+ "use crate::stream::StreamEndpoint;\n"
+ "\n"
+ "macro_rules! endpoints {\n"
+ "    ($($params:ident, $error:ident, $item:ident, $call:ident);* $(;)?) => {$(\n"
+ "        impl StreamEndpoint for stream_api::$params {\n"
+ "            type Item = models::$item;\n"
+ "            type Error = stream_api::$error;\n"
+ "\n"
+ "            async fn open(\n"
+ "                self,\n"
+ "                cfg: &Configuration,\n"
+ "            ) -> Result<reqwest::Response, x_sdk_gen::apis::Error<Self::Error>> {\n"
+ "                stream_api::$call(cfg, self).await\n"
+ "            }\n"
+ "        }\n"
+ "    )*};\n"
+ "}\n"
+ "\n"
+ "endpoints!(\n"
+ (map("    \(.pascal)Params, \(.pascal)Error, \(.item), \(.snake);\n") | join(""))
+ ");\n"
