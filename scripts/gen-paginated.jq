# Response schemas whose `meta` carries `next_token` -> crates/x-sdk/src/paginated.rs
.components.schemas
| to_entries
| map(select(.key | endswith("Response")))
| map(select(.value.properties.meta.properties.next_token != null))
| map({name: .key, item: (.value.properties.data.items["$ref"] | split("/") | last)})
| sort_by(.name)
| "// @generated by `just gen-paginated` from the spec. Do not edit.\n"
+ "\n"
+ "use x_sdk_gen::models;\n"
+ "\n"
+ "use crate::pagination::Paginated;\n"
+ "\n"
+ "macro_rules! paginated {\n"
+ "    ($($t:ty => $item:ty),* $(,)?) => {$(\n"
+ "        impl Paginated for $t {\n"
+ "            type Item = $item;\n"
+ "\n"
+ "            fn next_token(&self) -> Option<&str> {\n"
+ "                self.meta.as_deref()?.next_token.as_deref()\n"
+ "            }\n"
+ "\n"
+ "            fn into_items(self) -> Vec<$item> {\n"
+ "                self.data.unwrap_or_default()\n"
+ "            }\n"
+ "        }\n"
+ "    )*};\n"
+ "}\n"
+ "\n"
+ "paginated!(\n"
+ (map("    models::\(.name) => models::\(.item),\n") | join(""))
+ ");\n"
