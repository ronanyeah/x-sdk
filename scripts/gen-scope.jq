# OAuth2UserToken scopes in the spec -> crates/x-sdk/src/scope.rs
def variant: split("[._]"; null) | map((.[:1] | ascii_upcase) + .[1:]) | join("");

.components.securitySchemes.OAuth2UserToken.flows.authorizationCode.scopes
| to_entries
| sort_by(.key)
| map({name: .key, variant: (.key | variant), doc: (.value | gsub("\\s+"; " "))}) as $s
| "// @generated by `just gen-scopes` from the spec. Do not edit.\n"
+ "\n"
+ "/// An OAuth2 scope. `OfflineAccess` is what makes X return a refresh token.\n"
+ "#[derive(Debug, Clone, PartialEq, Eq, Hash)]\n"
+ "#[non_exhaustive]\n"
+ "pub enum Scope {\n"
+ ($s | map("    /// \(.doc)\n    \(.variant),\n") | join(""))
+ "    /// A scope that was not in the spec this crate was generated from.\n"
+ "    Other(String),\n"
+ "}\n"
+ "\n"
+ "impl Scope {\n"
+ "    pub fn as_str(&self) -> &str {\n"
+ "        match self {\n"
+ ($s | map("            Scope::\(.variant) => \"\(.name)\",\n") | join(""))
+ "            Scope::Other(s) => s,\n"
+ "        }\n"
+ "    }\n"
+ "}\n"
+ "\n"
+ "impl From<&str> for Scope {\n"
+ "    fn from(s: &str) -> Self {\n"
+ "        match s {\n"
+ ($s | map("            \"\(.name)\" => Scope::\(.variant),\n") | join(""))
+ "            _ => Scope::Other(s.to_owned()),\n"
+ "        }\n"
+ "    }\n"
+ "}\n"
